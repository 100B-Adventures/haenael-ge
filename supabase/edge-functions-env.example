# supabase/edge-functions-env.example
# Edge Function 시크릿 목록 (키 이름만 — 실값 절대 커밋 금지)
#
# 설정 방법:
#   supabase secrets set KEY=value
#
# 일괄 설정 (실값 채운 .env 파일로):
#   supabase secrets set --env-file ./supabase/.env.secrets
#
# 현재 설정된 시크릿 확인:
#   supabase secrets list

# ─── 운영 기능 스위치·알림 ──────────────────────────────────────────────────
PAYMENTS_ENABLED=false
CASHOUT_ENABLED=false
# 32자 이상의 고엔트로피 비밀값. cashout EF와 Vercel 서버에 같은 값을 설정한다.
# 계좌번호 pgcrypto 암·복호화 전용이며 로그·DB·Git에 원문을 남기지 않는다.
CASHOUT_ACCOUNT_ENCRYPTION_KEY=
SLACK_WEBHOOK_URL=
LEAD_RATE_LIMIT_SALT=
TOSS_WEBHOOK_TOKEN=

# ─── 카카오 OAuth (developers.kakao.com → 내 앱 → 앱 키 / 보안) ───────────────
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ─── 카카오 알림톡 (kakao.bizmsg.kr → API 키 / 발신 프로필) ──────────────────
KAKAO_ALIMTALK_ACCESS_KEY=
KAKAO_ALIMTALK_SENDER_KEY=

# ─── 토스페이먼츠 (developers.tosspayments.com → 내 개발 정보) ───────────────
# Secret key — 서버 승인·취소·webhook 상태 재조회에 사용
TOSS_SECRET_KEY=

# ─── PASS 본인인증 (나이스인증·PASS 계약 후 발급) ─────────────────────────────
# kyc-verify EF에서 사용
PASS_CLIENT_ID=
PASS_CLIENT_SECRET=

# ─── 지급대행 (다음 단계 — 현재 수동 지급 슬라이스에서는 호출하지 않음) ─────
PAYOUT_API_KEY=
PAYOUT_API_SECRET=
