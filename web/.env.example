# Public browser settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# GA4 공개 Measurement ID. 분석 동의 후에만 Google Analytics를 로드한다.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-only settings (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Edge Function의 동명 secret과 같은 32자 이상 무작위 값.
NOTIFY_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
# Vercel: Settings → Environment Variables에서 Production에만 등록.
# Preview/Development에는 등록하지 않는다. 로컬 테스트는 명령 환경으로만 임시 주입한다.
CASHOUT_ENABLED=false
# 쉼표로 구분한 Supabase Auth member UUID. D-017 세무 검토 전 시험 계정만 등록한다.
# CASHOUT_ENABLED=true여도 이 목록이 비어 있으면 모든 계정을 거부한다.
CASHOUT_ALLOWED_MEMBER_IDS=
# 버전별 암호화 키링. 활성 버전 변경 전 기존 버전 키를 삭제하지 않는다.
CASHOUT_ACCOUNT_ENCRYPTION_KEYS={"1":"replace-with-at-least-32-random-characters"}
CASHOUT_ACCOUNT_ACTIVE_KEY_VERSION=1
# 암호화 키와 반드시 다른 별도 HMAC 키.
CASHOUT_ACCOUNT_FINGERPRINT_KEY=replace-with-different-at-least-32-random-characters

# D-053: 아래 값은 격리 staging 배포 1건에만 주입한다. Vercel 프로젝트의
# 공용 Preview 환경변수로 등록하지 않으며 Production 키로 fallback하지 않는다.
CASHOUT_STAGING_TEST_ENABLED=false
CASHOUT_STAGING_TEST_ALLOWED_MEMBER_IDS=
CASHOUT_STAGING_TEST_ACCOUNT_ENCRYPTION_KEY=
CASHOUT_STAGING_TEST_ACCOUNT_FINGERPRINT_KEY=
