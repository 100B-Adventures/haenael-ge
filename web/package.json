{
  "name": "web",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node ../scripts/qa/check-deploy-env.mjs --target vercel-production --source runtime --only-if-vercel",
    "build": "next build",
    "lint": "oxlint .",
    "qa:predeploy-production": "node ../scripts/qa/check-deploy-env.mjs --target vercel-production --source provider && node ../scripts/qa/check-deploy-env.mjs --target supabase-production --source provider",
    "test:qa-contracts": "node ../scripts/qa/check-deploy-env.mjs --static-only && node ../scripts/qa/check-cashout-layer-contract.mjs && node ../scripts/qa/check-cashout-raise-coverage.mjs && node ../scripts/qa/check-cashout-notification-contract.mjs && node ../scripts/qa/lint-protected-routes.mjs && node ../scripts/qa/lint-web-custom-classes.mjs && node ../scripts/qa/run-contract-mutations.mjs",
    "start": "next start",
    "test": "npm run test:typecheck:security && vitest run --maxWorkers=2 --minWorkers=1",
    "test:typecheck:security": "tsc --noEmit -p tsconfig.security-tests.json",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "qa:verify-production": "node ../scripts/qa/verify-production.mjs",
    "qa:verify-production:auth": "playwright test --config=playwright.production.config.ts",
    "qa:design-tokens": "node ../scripts/qa/design-token-lint.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "next": "^16.4.0",
    "pretendard": "^1.3.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@storybook/nextjs-vite": "^10.2.8",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "oxlint": "^1.89.0",
    "shadcn": "^4.19.0",
    "storybook": "^10.2.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^56.5.0",
    "vitest": "^3.2.4"
  }
}
