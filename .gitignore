# haenael-ge .gitignore

# ─── 환경 변수 (시크릿 유출 방지) ────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
# .env.example 는 커밋 대상 (키 이름만, 실값 없음)

# ─── Node ─────────────────────────────────────────────────────────────────────
node_modules/
.npm

# ─── Next.js ──────────────────────────────────────────────────────────────────
web/.next/
web/out/
web/.vercel

# ─── Supabase ─────────────────────────────────────────────────────────────────
supabase/.temp/
supabase/seed.sql          # 시드는 별도 관리 (민감 데이터 가능성)

# ─── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ─── 빌드/캐시 ────────────────────────────────────────────────────────────────
.cache/
dist/
build/
*.tsbuildinfo

# ─── 작업 산출물 (세션 임시물 · 커밋 대상 아님) ─────────────────────────────
scratchpad/
web/playwright-report/
web/playwright/.auth/
web/test-results/
.codex/logs/

# ─── IDE ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.gstack/

# QA 캡처 증거(용량 큼, 로컬 보관)
artifacts/

# 편집기 개인 설정
.obsidian/
.vercel

# 세션 전용 로컬 산출물 (커밋 대상 아님)
.chrome-profile
session-state-archive/

# 회장 요청 원문 대장: 장기 보관 불필요 + 공개 저장소 노출 방지 (회장 2026-10-13)
wiki/거버넌스/요청.md
.chrome-profile/
.goal/
*.obsidian/workspace.json
.next/
.turbo/
.venv/
__pycache__/
*.log
.playwright-mcp/
coverage/

# 2026-10-28 미커밋 정리: 런타임·캐시·브라우저 프로필은 추적하지 않는다(대시보드 구조 정합).
