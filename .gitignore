# haenael-ge .gitignore

# ─── 환경 변수 (시크릿 유출 방지) ────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
# .env.example 는 커밋 대상 (키 이름만, 실값 없음)

# ─── Node ─────────────────────────────────────────────────────────────────────
node_modules/
.npm

# ─── Next.js ──────────────────────────────────────────────────────────────────
web/.next/
web/out/
web/.vercel

# ─── Supabase ─────────────────────────────────────────────────────────────────
supabase/.temp/
supabase/seed.sql          # 시드는 별도 관리 (민감 데이터 가능성)

# ─── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ─── 빌드/캐시 ────────────────────────────────────────────────────────────────
.cache/
dist/
build/
*.tsbuildinfo

# ─── IDE ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
